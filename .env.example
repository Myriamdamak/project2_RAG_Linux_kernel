# Copy to .env and set your key locally. Never commit a real API key.
OPENAI_API_KEY=
LIB_GENERATOR=openai:gpt-5.4-nano
LIB_REWRITE_MODEL=gpt-5.4-mini
LIB_REASONING_EFFORT=none
LIB_ANSWER_CACHE=true
LIB_ANSWER_CACHE_TTL=3600
LIB_ANSWER_CACHE_SIZE=1000
# LIB_OPENAI_BASE_URL=https://api.openai.com/v1

# Qdrant Cloud: copy the endpoint and API key from your cluster dashboard.
CLUSTER_KEY=
LIB_QDRANT_URL=
LIB_QDRANT_COLLECTION=kernel_documentation
LIB_CHUNKER=structure
LIB_QDRANT_HNSW_M=16
LIB_QDRANT_HNSW_EF_CONSTRUCT=100
LIB_QDRANT_HNSW_EF=256
LIB_QDRANT_FULL_SCAN_THRESHOLD=1000
LIB_QDRANT_INDEXING_THRESHOLD=2000
# Optional local copy of the configured sentence-transformers model:
# LIB_EMBED_MODEL_PATH=index_qdrant/bge_model
